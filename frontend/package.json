{
  "name": "gh-payroll-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Multi-tenant PWA for Ghanaian payroll management.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --max-warnings=0 \"src/**/*.{js,jsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json,md}\"",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@apollo/client": "^3.11.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.5.0",
    "graphql": "^16.9.0",
    "graphql-ws": "^6.0.7",
    "lucide-react": "^0.420.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.23.8",
    "localforage": "^1.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@tailwindcss/forms": "^0.5.4",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^2.0.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.35.0",
    "globals": "^14.0.0",
    "postcss": "^8.4.40",
    "prettier": "^2.8.8",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.7",
    "terser": "^5.18.0",
    "vite": "^5.3.5",
    "vite-plugin-pwa": "^0.20.1",
    "vitest": "^5.1.0"
  }
}
