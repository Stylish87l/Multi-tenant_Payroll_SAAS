generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  
}

enum BackgroundJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum PayrollReviewStatus {
  COMPLETED
  FAILED
}

enum PayrollFindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PayrollFindingStatus {
  OPEN
  CONFIRMED
  DISMISSED
  RESOLVED
}

enum PayrollReviewDecision {
  CONFIRMED
  DISMISSED
  NEEDS_INVESTIGATION
  RESOLVED
}

model Company {
  id              String       @id @default(uuid())
  name            String
  tin             String?      @unique
  address         String?
  contactEmail    String?
  contactPhone    String?
  themeColor      String?
  logoUrl         String?
  footerNote      String?
  payslipTemplate Json?
  createdBy       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  employees       Employee[]
  invites         Invite[]
  payrollRuns     PayrollRun[]
  taxConfigs      TaxConfig[]
  users           User[]
  notifications   Notification[]
  auditLogs        AuditLog[]
  backgroundJobs   BackgroundJob[]
  payrollReviews   PayrollReview[]
  payrollReviewFindings PayrollReviewFinding[]
  payrollReviewActions PayrollReviewAction[]
  employeeImportPreviews EmployeeImportPreview[]
  complianceAssessments ComplianceAssessment[]
  complianceSpecialistAccess ComplianceSpecialistAccess[]
  complianceReviews ComplianceAssessmentReview[]

  @@map("companies")
}

model User {
  id                     String                @id @default(uuid())
  companyId              String
  email                  String                @unique
  password               String
  name                   String?
  role                   Role                  @default(EMPLOYEE)
  status                 Status                @default(ACTIVE)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  deletedAt              DateTime?
  twoFactorEnabled       Boolean               @default(false) @map("two_factor_enabled")
  twoFactorSecretEncrypted String?              @map("two_factor_secret_encrypted")
  twoFactorVerifiedAt    DateTime?              @map("two_factor_verified_at")
  twoFactorLastCounter   BigInt?                @map("two_factor_last_counter")
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]
  auditLogs              AuditLog[]
  invites                Invite[]
  notifications          Notification[]
  processedRuns          PayrollRun[]          @relation("RunProcessor")
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  company                Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeProfile        Employee?
  notificationPreference NotificationPreference?
  requestedPayrollReviews PayrollReview[] @relation("PayrollReviewRequester")
  payrollReviewActions PayrollReviewAction[] @relation("PayrollReviewActor")
  employeeImportPreviews EmployeeImportPreview[]
  complianceAssessments ComplianceAssessment[] @relation("ComplianceAssessmentAuthor")
  complianceSpecialistAccess ComplianceSpecialistAccess[] @relation("ComplianceSpecialistUser")
  complianceAccessGranted ComplianceSpecialistAccess[] @relation("ComplianceAccessGrantor")
  complianceReviews ComplianceAssessmentReview[] @relation("ComplianceAssessmentReviewer")

  @@index([companyId])
  @@map("users")
}

model Employee {
  id                  String        @id @default(uuid())
  companyId           String
  userId              String?       @unique
  name                String
  email               String
  age                 Int           @default(30)
  basicSalary         Decimal       @db.Decimal(18, 4)
  housingAllowance    Decimal       @default(0) @db.Decimal(18, 4)
  transportAllowance  Decimal       @default(0) @db.Decimal(18, 4)
  otherAllowance      Decimal       @default(0) @db.Decimal(18, 4)
  isMarried           Boolean       @default(false)
  hasResponsibility   Boolean       @default(false)
  childrenCount       Int           @default(0)
  isDisabled          Boolean       @default(false)
  agedDependentsCount Int           @default(0)
  bankName            String?
  bankCode            String?
  // These three existing columns store AES-256-GCM ciphertext; Prisma query extensions
  // decrypt them only after reads and encrypt them before writes.
  bankAccount         String?
  ssnitNumber         String?
  ghanaCardPin        String?
  ssnitNumberHash     String? @map("ssnit_number_hash")
  ghanaCardPinHash    String? @map("ghana_card_pin_hash")
  piiEncryptionVersion Int? @map("pii_encryption_version")
  position            String?
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?
  company             Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user                User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  payrollItems        PayrollItem[]
  payrollReviewFindings PayrollReviewFinding[]

  @@unique([companyId, email])
  @@unique([companyId, ssnitNumberHash], map: "employees_companyId_ssnitNumberHash_key")
  @@unique([companyId, ghanaCardPinHash], map: "employees_companyId_ghanaCardPinHash_key")
  @@index([companyId, isActive])
  @@map("employees")
}

model PayrollRun {
  id            String        @id @default(uuid())
  companyId     String
  month         String
  status        PayrollStatus @default(DRAFT)
  runType       RunType       @default(REGULAR)
  processedById String?
  processedAt   DateTime?
  errorMessage  String?
  taxConfigSnapshot Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  items         PayrollItem[]
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  processedBy   User?         @relation("RunProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  payrollReviews PayrollReview[]

  @@index([companyId])
  @@map("payroll_runs")
}

model PayrollItem {
  id            String        @id @default(uuid())
  payrollRunId  String
  employeeId    String
  grossSalary   Decimal       @db.Decimal(18, 4)
  basicSalarySnapshot Decimal? @db.Decimal(18, 4)
  housingAllowanceSnapshot Decimal? @db.Decimal(18, 4)
  transportAllowanceSnapshot Decimal? @db.Decimal(18, 4)
  otherAllowanceSnapshot Decimal? @db.Decimal(18, 4)
  taxableIncome Decimal       @db.Decimal(18, 4)
  ssnitEmployee Decimal       @db.Decimal(18, 4)
  ssnitEmployer Decimal       @db.Decimal(18, 4)
  ssnitTier1    Decimal       @db.Decimal(18, 4)
  ssnitTier2    Decimal       @db.Decimal(18, 4)
  payeTax       Decimal       @db.Decimal(18, 4)
  reliefInputsSnapshot Json?
  netPay        Decimal       @db.Decimal(18, 4)
  paymentStatus PaymentStatus @default(PENDING)
  paymentRef    String?
  payoutProvider String? @map("payout_provider")
  providerTransactionId String? @map("provider_transaction_id")
  payoutSubmittedAt DateTime? @map("payout_submitted_at")
  payoutLastCheckedAt DateTime? @map("payout_last_checked_at")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payrollRun    PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)

  @@unique([payrollRunId, employeeId])
  @@index([payrollRunId])
  @@index([employeeId])
  @@index([paymentStatus])
  @@index([payoutProvider, paymentStatus], map: "payroll_items_payout_provider_status_idx")
  @@map("payroll_items")
}

model AuditLog {
  id            String    @id @default(uuid())
  userId        String?
  companyId     String?
  action        String
  details       Json
  ipAddress     String?
  createdAt     DateTime  @default(now())
  correlationId String?
  performedBy   String?
  resourceId    String?
  resourceType  String?
  userAgent     String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: Restrict)
  company       Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model TwoFactorRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
  @@map("two_factor_recovery_codes")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id               String    @id @default(uuid())
  userId           String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  deviceInfo       String?
  ipAddress        String?
  lastUsedAt       DateTime?
  revocationReason String?
  revokedBy        String?
  tokenId          String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenId])
  @@map("refresh_tokens")
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  companyId String?
  type      NotificationType
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  content   Json
  sentAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company?            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("notifications")
}

model NotificationPreference {
  id                    String   @id @default(uuid())
  userId                String   @unique
  smsOptIn              Boolean  @default(false)
  emailOptIn            Boolean  @default(true)
  twoFactorEnabled      Boolean  @default(false)
  darkMode              Boolean  @default(false)
  language              String   @default("en")
  notificationsEnabled  Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Invite {
  id        String   @id @default(uuid())
  token     String   @unique
  email     String
  role      Role
  expiresAt DateTime
  companyId String
  userId    String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("invites")
}

model BackgroundJob {
  id             String             @id @default(uuid())
  type           String
  payload        Json
  companyId      String?
  idempotencyKey String             @unique
  status         BackgroundJobStatus @default(PENDING)
  attempts       Int                @default(0)
  availableAt    DateTime           @default(now())
  lockedAt       DateTime?
  lockToken      String?
  lastError      String?
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
  company        Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([companyId, createdAt])
  @@map("background_jobs")
}

model TaxConfig {
  id        String   @id @default(uuid())
  companyId String?                     // now optional
  year      Int
  type      String
  config        Json
  effectiveFrom DateTime @default("2026-01-01T00:00:00.000Z") @map("effective_from") @db.Timestamptz(3)
  createdAt     DateTime @default(now())
  company       Company? @relation(fields: [companyId], references: [id], onDelete: Restrict) // Prevent tenant config from becoming global when a company is removed.

  @@index([companyId, type, year, effectiveFrom], map: "tax_configs_company_type_year_effective_from_idx")
  @@map("tax_configs")
}


model ComplianceSource {
  id                  String             @id @default(uuid())
  name                String
  authority           String
  topic               String
  url                 String             @unique
  active              Boolean            @default(true)
  pollIntervalMinutes Int                @default(360) @map("poll_interval_minutes")
  etag                String?
  lastModified        String?            @map("last_modified")
  lastContentHash     String?            @map("last_content_hash")
  lastCheckedAt       DateTime?          @map("last_checked_at")
  lastStatus          String?            @map("last_status")
  lastError           String?            @db.Text @map("last_error")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  notices             ComplianceNotice[]

  @@index([active, lastCheckedAt])
  @@map("compliance_sources")
}

model ComplianceNotice {
  id          String                 @id @default(uuid())
  sourceId    String                 @map("source_id")
  title       String
  url         String
  contentHash String                 @map("content_hash")
  excerpt     String                 @db.Text
  status      String                 @default("NEW")
  detectedAt  DateTime               @default(now()) @map("detected_at")
  publishedAt DateTime?              @map("published_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  source      ComplianceSource       @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  assessments ComplianceAssessment[]

  @@unique([sourceId, contentHash])
  @@index([status, detectedAt(sort: Desc)])
  @@map("compliance_notices")
}

model ComplianceAssessment {
  id             String           @id @default(uuid())
  noticeId       String           @map("notice_id")
  companyId      String           @map("company_id")
  createdById    String           @map("created_by_id")
  summary        String           @db.Text
  impactAreas    Json             @map("impact_areas")
  proposedActions Json            @map("proposed_actions")
  status         String           @default("DRAFT")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  submittedAt    DateTime?        @map("submitted_at")
  reviewedAt     DateTime?        @map("reviewed_at")
  notice         ComplianceNotice @relation(fields: [noticeId], references: [id], onDelete: Restrict)
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy      User             @relation("ComplianceAssessmentAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  reviews        ComplianceAssessmentReview[]

  @@unique([noticeId, companyId])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([noticeId, status])
  @@map("compliance_assessments")
}


model ComplianceSpecialistAccess {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  companyId   String   @map("company_id")
  grantedById String   @map("granted_by_id")
  grantedAt   DateTime @default(now()) @map("granted_at")
  revokedAt   DateTime? @map("revoked_at")
  user        User     @relation("ComplianceSpecialistUser", fields: [userId], references: [id], onDelete: Restrict)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  grantedBy   User     @relation("ComplianceAccessGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([userId, companyId])
  @@index([companyId, revokedAt])
  @@index([userId, revokedAt])
  @@map("compliance_specialist_access")
}

model ComplianceAssessmentReview {
  id           String              @id @default(uuid())
  assessmentId String              @map("assessment_id")
  companyId    String              @map("company_id")
  reviewerId   String              @map("reviewer_id")
  decision     String
  rationale    String              @db.Text
  createdAt    DateTime            @default(now()) @map("created_at")
  assessment   ComplianceAssessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reviewer     User                @relation("ComplianceAssessmentReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([assessmentId, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("compliance_assessment_reviews")
}

model PayrollReview {
  id            String              @id @default(uuid())
  companyId     String
  payrollRunId  String
  requestedById String?
  status        PayrollReviewStatus @default(COMPLETED)
  summary       String?             @db.Text
  provider      String?
  model         String?
  inputFingerprint String? @map("input_fingerprint")
  promptVersion String? @map("prompt_version")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payrollRun    PayrollRun          @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  requestedBy   User?               @relation("PayrollReviewRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  findings      PayrollReviewFinding[]

  @@index([companyId, createdAt(sort: Desc)])
  @@index([payrollRunId])
  @@map("payroll_reviews")
}

model PayrollReviewFinding {
  id             String                 @id @default(uuid())
  reviewId       String
  companyId      String
  employeeId     String?
  code           String
  category       String
  severity       PayrollFindingSeverity
  status         PayrollFindingStatus   @default(OPEN)
  title          String
  description    String                 @db.Text
  evidence       Json
  recommendation String                 @db.Text
  aiExplanation  String?                @db.Text
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  review         PayrollReview          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  company        Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee       Employee?              @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  actions        PayrollReviewAction[]

  @@index([companyId, status])
  @@index([reviewId, severity])
  @@index([employeeId])
  @@map("payroll_review_findings")
}

model PayrollReviewAction {
  id        String                @id @default(uuid())
  findingId String
  companyId String
  actorId   String
  decision  PayrollReviewDecision
  comment   String?               @db.Text
  createdAt DateTime              @default(now())
  finding   PayrollReviewFinding  @relation(fields: [findingId], references: [id], onDelete: Restrict)
  company   Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actor     User                  @relation("PayrollReviewActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([findingId, createdAt(sort: Desc)])
  @@map("payroll_review_actions")
}

model EmployeeImportPreview {
  id              String   @id @default(uuid())
  companyId       String
  userId          String
  payloadEncrypted String  @map("payload_encrypted") @db.Text
  rowCount        Int      @map("row_count")
  status          String   @default("PREVIEWED")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, status, expiresAt], map: "employee_import_previews_scope_idx")
  @@map("employee_import_previews")
}

enum Role {
  SUPER_ADMIN
  COMPLIANCE_SPECIALIST
  ADMIN
  HR
  ACCOUNTANT
  EMPLOYEE
  CUSTOM
}

enum Status {
  PENDING
  ACTIVE
  SUSPENDED
}

enum PayrollStatus {
  DRAFT
  FINALIZED
  CANCELLED
}

enum RunType {
  REGULAR
  BONUS
  ADJUSTMENT
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SENT
  PAID
  FAILED
}

enum NotificationType {
  INVITE
  PAYSLIP
  ALERT
  APPROVAL
  SYSTEM
  REMINDER
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
}