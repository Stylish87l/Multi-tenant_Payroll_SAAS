{
  "name": "backend",
  "version": "1.0.0",
  "description": "Multi-Tenant Ghana Payroll System",
  "main": "server.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "prisma migrate deploy && node server.js",
    "worker": "node workers/backgroundWorker.js",
    "dev": "node --env-file=.env --watch server.js",
    "build": "prisma generate",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "audit": "npm audit --omit=dev",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "employee-pii:backfill": "node scripts/backfillEmployeePii.js",
    "employee-pii:rotate": "node scripts/rotateEmployeePiiKeys.js"
  },
  "keywords": [
    "payroll",
    "ghana",
    "multi-tenant",
    "graphql",
    "prisma",
    "express"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "effect": "3.22.5",
    "archiver": {
      "readdir-glob": {
        "minimatch": "11.0.1"
      }
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-tools/schema": "^10.0.0",
    "@opentelemetry/api": "^1.10.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "archiver": "8.0.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dataloader": "^2.2.3",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "graphql": "^16.11.0",
    "graphql-depth-limit": "^1.1.0",
    "graphql-subscriptions": "^3.1.0",
    "graphql-tag": "^2.12.6",
    "graphql-ws": "^6.4.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.6.1",
    "p-retry": "^9.0.0",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "uuid": "^11.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "globals": "^14.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.3.2"
  }
}
